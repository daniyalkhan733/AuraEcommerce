<nav class="navbar navbar-expand-lg navbar-light bg-light sticky-top shadow-sm">
  <div class="container">
    <a class="navbar-brand d-flex align-items-center" routerLink="/products">
      <span class="me-2">✨</span> AuraEcom
    </a>

    <button
      class="navbar-toggler border-0"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto align-items-center">
        <li class="nav-item">
          <a class="nav-link" routerLink="/products" routerLinkActive="active" [routerLinkActiveOptions]="{exact: true}">
            Products
          </a>
        </li>

        <li class="nav-item">
          <a class="nav-link position-relative py-2 px-3" routerLink="/cart" routerLinkActive="active">
            <i class="bi bi-cart3 fs-5"></i>
            Cart
            <span class="badge rounded-pill bg-primary ms-1" [class.badge-bump]="cartCount > 0">
              {{ cartCount }}
            </span>
          </a>
        </li>

        <li class="nav-item ms-lg-3" *ngIf="!authService.isLoggedIn()">
          <a class="btn btn-primary" routerLink="/login">Login</a>
        </li>

        <li class="nav-item ms-lg-3 dropdown" *ngIf="authService.isLoggedIn()">
          <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown">
            Account
          </a>
          <ul class="dropdown-menu dropdown-menu-end border-0 shadow">
            <li><a class="dropdown-item" routerLink="/orders">My Orders</a></li>
            <li><hr class="dropdown-divider"></li>
            <li><a class="dropdown-item text-danger" href="javascript:void(0)" (click)="logout()">Logout</a></li>
          </ul>
        </li>
      </ul>
    </div>
  </div>
</nav>

<main class="min-vh-100">
  <div class="container py-4">
    <router-outlet></router-outlet>
  </div>
</main>

<footer class="bg-white py-5 mt-5 border-top">
  <div class="container">
    <div class="row">
      <div class="col-md-4 mb-4">
        <h5 class="fw-bold text-primary">AuraEcom</h5>
        <p class="text-muted">Experience luxury shopping with our curated collection of premium products. Quality and style guaranteed.</p>
      </div>
      <div class="col-md-2 mb-4">
        <h6 class="fw-bold">Shop</h6>
        <ul class="list-unstyled">
          <li><a routerLink="/products" class="text-muted text-decoration-none">All Products</a></li>
          <li><a href="#" class="text-muted text-decoration-none">Categories</a></li>
          <li><a href="#" class="text-muted text-decoration-none">New Arrivals</a></li>
        </ul>
      </div>
      <div class="col-md-2 mb-4">
        <h6 class="fw-bold">Support</h6>
        <ul class="list-unstyled">
          <li><a href="#" class="text-muted text-decoration-none">Help Center</a></li>
          <li><a href="#" class="text-muted text-decoration-none">Shipping Info</a></li>
          <li><a href="#" class="text-muted text-decoration-none">Returns</a></li>
        </ul>
      </div>
      <div class="col-md-4 mb-4 text-md-end">
        <h6 class="fw-bold">Stay Connected</h6>
        <div class="d-flex justify-content-md-end gap-3 mt-3">
          <a href="#" class="text-primary fs-4"><i class="bi bi-facebook"></i></a>
          <a href="#" class="text-primary fs-4"><i class="bi bi-instagram"></i></a>
          <a href="#" class="text-primary fs-4"><i class="bi bi-twitter-x"></i></a>
        </div>
      </div>
    </div>
    <hr class="my-4">
    <div class="row align-items-center">
      <div class="col-md-6 text-center text-md-start">
        <p class="text-muted mb-0 small">&copy; 2026 AuraEcom. Made with love for the recruitment assessment.</p>
      </div>
      <div class="col-md-6 text-center text-md-end">
        <img src="https://img.icons8.com/color/48/000000/visa.png" width="30" alt="Visa">
        <img src="https://img.icons8.com/color/48/000000/mastercard.png" width="30" alt="Mastercard">
        <img src="https://img.icons8.com/color/48/000000/paypal.png" width="30" alt="Paypal">
      </div>
    </div>
  </div>
</footer>